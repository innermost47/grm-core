# The Relational Universe, served by Apache (simulation.anthony-charretier.fr)
# SPDX-License-Identifier: AGPL-3.0-or-later  Copyright (C) 2026 Anthony Charretier

Options -Indexes
DirectoryIndex index.html

# ---------------------------------------------------------------- HTTPS only
<IfModule mod_rewrite.c>
  RewriteEngine On
  # behind a proxy or a CDN the original scheme is in X-Forwarded-Proto
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # one address only: no www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # what is in the folder but not for the public
  RewriteRule ^(tests/|.*\.md$) - [R=404,L]
</IfModule>

# ---------------------------------------------------------------- security headers
<IfModule mod_headers.c>
  # browsers remember to come back in HTTPS (one year). Sent only over HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ---------------------------------------------------------------- types
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType application/json .json
  AddCharset utf-8 .html .js .mjs .css .json .webmanifest .svg .txt .xml
</IfModule>

# ---------------------------------------------------------------- compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml text/plain application/xml text/xml
</IfModule>

# ---------------------------------------------------------------- caching
# the page, scripts and styles are revalidated every time (an update shows at once);
# images and icons are kept a month
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|mjs|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

